generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  CRITICA
}

enum ServiceOrderType {
  ROMPIMENTO
  LENTIDAO
  CONFIGURACAO_ONU
  TROCA_SENHA
  CANCELAMENTO
  AUDITORIA
  INSTALACAO
  BGP
  DNS
  PROXMOX
  FIREWALL
  ROTEAMENTO_CGNAT
  INFRAESTRUTURA
  CONSULTORIA_GERAL
  OUTRO
}

enum ServiceOrderStatus {
  ABERTA
  EM_ANALISE
  AG_CAMPO
  AG_TERCEIROS
  RESOLVIDA
  FECHADA
  CANCELADA
}

enum OccurrenceStatus {
  ABERTA
  EM_EXECUCAO
  PENDENTE
  ENCERRADA
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SourceSystem {
  ERP
  SGP
  WEBHOOK
  POLLING
}

enum SyncStatus {
  RECEIVED
  PROCESSED
  CONFLICT
  FAILED
}

enum AuditAction {
  ACCESS_DENIED
  RESOURCE_CREATE
  RESOURCE_UPDATE
  RESOURCE_DELETE
  ROSTER_UPDATE
  SHIFT_REPORT_SAVE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  OS_CREATE
  OS_UPDATE
  OS_CLOSE
  OS_REOPEN
  OS_CANCEL
  SLA_CHANGE
  ROLE_CHANGE
  CREDENTIAL_ACCESS
  EXPORT
  SYNC
  CREATE_TENANT
  UPDATE_TENANT
  CREATE_USER
  UPDATE_USER
  DELETE_USER
}

model Tenant {
  orderOrigins     String[]         @default([])
  providerProfile  ProviderProfile?
  id               String           @id @default(uuid())
  legalName        String
  tradeName        String
  taxId            String           @unique
  slug             String           @unique
  domain           String           @unique
  timezone         String           @default("America/Sao_Paulo")
  techContactName  String
  techContactEmail String
  techContactPhone String
  status           TenantStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  users                      UserTenant[]
  serviceOrders              ServiceOrder[]
  occurrences                Occurrence[]
  integrations               ProviderIntegration[]
  slaPolicies                SlaPolicy[]
  reportExports              ReportExport[]
  knowledgeArticles          KnowledgeArticle[]
  knowledgeCredentials       KnowledgeCredential[]
  notes                      Note[]
  calendarEvents             CalendarEvent[]
  auditLogs                  AuditLog[]
  syncEvents                 SyncEvent[]
  occurrenceAnnotations      OccurrenceAnnotation[]
  sectors                    TenantSector[]
  assets                     Asset[]
  assetConfigSnapshots       AssetConfigSnapshot[]
  changeRequests             ChangeRequest[]
  timeEntries                TimeEntry[]
  notificationConfigs        NotificationConfig[]
  onCallSchedules            OnCallSchedule[]
  teamRosterPolicies         TeamRosterPolicy[]
  teamRosterDays             TeamRosterDay[]
  apiKeys                    ApiKey[]
  satisfactionResponses      SatisfactionResponse[]
  workflowRules              WorkflowRule[]
  osProcessTemplates         OsProcessTemplate[]
  serviceOrderStatusEvents   ServiceOrderStatusEvent[]
  workflowExecutionLogs      WorkflowExecutionLog[]
  businessCalendars          BusinessCalendar[]
  businessCalendarExceptions BusinessCalendarException[]
  slaAuditEvents             SlaAuditEvent[]
  serviceCatalogItems        ServiceCatalogItem[]
  humanProcessTemplates      ServiceProcessTemplate[]
  customers                  Customer[]

  @@index([status])
}

model TenantSector {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  responsibleOccurrences Occurrence[] @relation("OccurrenceResponsible")
  openedOccurrences Occurrence[] @relation("OccurrenceOpener")
  id                      String       @id @default(uuid())
  name                    String
  email                   String       @unique
  passwordHash            String
  status                  UserStatus   @default(ACTIVE)
  twoFactorEnabled        Boolean      @default(false)
  twoFactorSecretEnc      String?
  twoFactorLastCounter    Int?
  bootstrapTokenHash      String?
  bootstrapTokenExpiresAt DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?
  sourceSystem            SourceSystem @default(ERP)
  externalId              String?
  sourceMetadata          Json         @default("{}")

  tenants                  UserTenant[]
  sessions                 Session[]
  bootstrapOtps            BootstrapOtp[]
  ownedOrders              ServiceOrder[]            @relation("OwnerOrders")
  assignedOrders           ServiceOrder[]            @relation("AssigneeOrders")
  occurrences              ServiceOrderOccurrence[]
  approvalsRequested       ServiceOrderApproval[]    @relation("ApprovalRequester")
  approvalsReviewed        ServiceOrderApproval[]    @relation("ApprovalReviewer")
  createdCredentials       KnowledgeCredential[]     @relation("CredentialCreator")
  auditLogs                AuditLog[]
  reportExports            ReportExport[]
  notes                    Note[]
  knowledgeArticles        KnowledgeArticle[]
  occurrenceAnnotations    OccurrenceAnnotation[]
  calendarEventsCreated    CalendarEvent[]           @relation("CalendarEventCreator")
  calendarEventsAssigned   CalendarEvent[]           @relation("CalendarEventAssignee")
  createdAssets            Asset[]
  changeRequestsRequested  ChangeRequest[]           @relation("ChangeRequestRequester")
  changeRequestsApproved   ChangeRequest[]           @relation("ChangeRequestApprover")
  changeRequestsExecuted   ChangeRequest[]           @relation("ChangeRequestExecutor")
  timeEntries              TimeEntry[]
  onCallSchedules          OnCallSchedule[]
  createdApiKeys           ApiKey[]
  createdConfigSnapshots   AssetConfigSnapshot[]
  serviceOrderStatusEvents ServiceOrderStatusEvent[]

  @@unique([sourceSystem, externalId])
}

// A consultancy customer belongs to a workspace; it is not a separate login tenant.
model Customer {
  id             String       @id @default(uuid())
  tenantId       String
  legalName      String
  tradeName      String
  taxId          String?
  personType     String
  address        Json         @default("{}")
  contacts       Json         @default("{}")
  sourceSystem   SourceSystem @default(ERP)
  externalId     String?
  sourceMetadata Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrences Occurrence[]
  portalUsers UserTenant[]
  networkTopology NetworkTopology?

  @@unique([tenantId, taxId])
  @@unique([tenantId, sourceSystem, externalId])
  @@index([tenantId, tradeName])
}

model NetworkTopology {
  id              String   @id @default(uuid())
  tenantId        String
  customerId      String   @unique
  title           String
  xmlEnc          String   @db.Text
  version         Int      @default(1)
  updatedByUserId  String
  updatedByName    String
  sourceFileName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  revisions NetworkTopologyRevision[]

  @@index([tenantId, updatedAt])
}

model NetworkTopologyRevision {
  id             String   @id @default(uuid())
  topologyId     String
  version        Int
  title          String
  xmlEnc         String   @db.Text
  savedByUserId  String
  savedByName    String
  sourceFileName String?
  createdAt      DateTime @default(now())

  topology NetworkTopology @relation(fields: [topologyId], references: [id], onDelete: Cascade)

  @@unique([topologyId, version])
}

model Occurrence {
  analystResponsibleUserId String?
  openedByUserId String?
  responsibleUser User? @relation("OccurrenceResponsible", fields: [analystResponsibleUserId], references: [id], onDelete: SetNull)
  openedByUser User? @relation("OccurrenceOpener", fields: [openedByUserId], references: [id], onDelete: SetNull)
  id                 String           @id @default(uuid())
  tenantId           String
  number             String
  provider           String
  type               String
  status             OccurrenceStatus @default(ABERTA)
  sector             String
  origin             String
  openedByName       String
  analystResponsible String
  description        String
  sourceSystem       SourceSystem     @default(ERP)
  externalId         String?
  sourceMetadata     Json             @default("{}")
  closedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  customerId         String?

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceOrders ServiceOrder[]
  annotations   OccurrenceAnnotation[]
  processes     ServiceProcessInstance[]

  @@unique([tenantId, sourceSystem, externalId])
  @@unique([tenantId, number])
  @@index([tenantId, provider, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, customerId, status])
}

model Role {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userTenants UserTenant[]
}

model UserTenant {
  id         String   @id @default(uuid())
  userId     String
  tenantId   String
  roleId     String
  sector     String?
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, roleId])
  @@index([tenantId, customerId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  tenantId         String?
  refreshTokenHash String
  device           String?
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model BootstrapOtp {
  id          String    @id @default(uuid())
  userId      String
  otp         String // OTP de 6 dígitos
  attempts    Int       @default(0) // Contador de tentativas falhas
  validatedAt DateTime? // null = ainda não validado, preenchido = validado com sucesso
  expiresAt   DateTime // Quando o OTP expira (15 minutos por padrão)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, validatedAt])
}

model ServiceOrder {
  id                String             @id @default(uuid())
  tenantId          String
  occurrenceId      String?
  protocol          String
  externalProtocol  String?
  sourceSystem      SourceSystem       @default(ERP)
  sourceMetadata    Json               @default("{}")
  processInstanceId String?
  processNodeId     String?
  parentOrderId     String?
  rootOrderId       String?
  slaEligible       Boolean            @default(true)
  type              ServiceOrderType
  priority          Priority
  status            ServiceOrderStatus @default(ABERTA)
  title             String
  description       String
  ownerUserId       String?
  ownerName         String?
  assigneeUserId    String?
  analystName       String?
  requester         String?
  sector            String?
  origin            String?
  deadlineAt        DateTime
  originalDeadlineAt DateTime?
  pausedAt          DateTime?
  pauseReason       String?
  scheduledAt       DateTime?
  scheduleStartedAt DateTime?
  handoffNotes      String?
  changeRequestId   String?
  changeRequest     ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?
  closedAt          DateTime?
  canceledAt        DateTime?
  reopenedCount     Int                @default(0)
  requiresApproval  Boolean            @default(false)
  approvalCompleted Boolean            @default(false)
  tags              String[]           @default([])
  internalNotes     String?
  isCustomerVisible Boolean            @default(true)
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processInstance          ServiceProcessInstance?   @relation(fields: [processInstanceId], references: [id], onDelete: Restrict)
  parentOrder              ServiceOrder?             @relation("OrderChildren", fields: [parentOrderId], references: [id], onDelete: Restrict)
  childOrders              ServiceOrder[]            @relation("OrderChildren")
  rootOrder                ServiceOrder?             @relation("OrderRoot", fields: [rootOrderId], references: [id], onDelete: Restrict)
  descendantOrders         ServiceOrder[]            @relation("OrderRoot")
  processSteps             ServiceProcessStep[]
  processLinks             ServiceProcessOrderLink[]
  occurrence               Occurrence?               @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  owner                    User?                     @relation("OwnerOrders", fields: [ownerUserId], references: [id])
  assignee                 User?                     @relation("AssigneeOrders", fields: [assigneeUserId], references: [id])
  occurrences              ServiceOrderOccurrence[]
  attachments              ServiceOrderAttachment[]
  approvals                ServiceOrderApproval[]
  slaEvents                SlaEvent[]
  assets                   AssetServiceOrder[]
  timeEntries              TimeEntry[]
  satisfaction             SatisfactionResponse?
  serviceOrderStatusEvents ServiceOrderStatusEvent[]
  slaAuditEvents           SlaAuditEvent[]

  @@unique([tenantId, protocol])
  @@unique([tenantId, externalProtocol])
  @@index([tenantId, status, priority, deadlineAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, occurrenceId, createdAt(sort: Desc)])
  @@index([tenantId, requester])
  @@index([tenantId, resolvedAt])
  @@index([tenantId, closedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, assigneeUserId, status])
  @@index([tenantId, ownerUserId])
}

model ServiceOrderOccurrence {
  editable Boolean @default(false)
  version Int @default(1)
  editedAt DateTime?
  mirroredAnnotationId String?
  id                String       @id @default(uuid())
  serviceOrderId    String
  actorUserId       String?
  sourceSystem      SourceSystem @default(ERP)
  externalId        String?
  sourceAuthorName  String?
  message           String
  isCustomerVisible Boolean      @default(true)
  createdAt         DateTime     @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id])

  @@unique([serviceOrderId, sourceSystem, externalId])
  @@index([serviceOrderId, createdAt(sort: Desc)])
}

/// Human processes keep immutable definitions and durable, versioned execution state.
model ServiceProcessInstance {
  id              String    @id @default(uuid())
  tenantId        String
  occurrenceId    String
  templateCode    String
  templateVersion Int
  definition      Json
  state           Json
  status          String    @default("ACTIVE")
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  engineVersion   Int       @default(1)
  rootOrderId     String?

  occurrence Occurrence                @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  orders     ServiceOrder[]
  steps      ServiceProcessStep[]
  links      ServiceProcessOrderLink[]
  events     ServiceProcessEvent[]

  @@unique([tenantId, rootOrderId])
  @@index([tenantId, occurrenceId])
  @@index([tenantId, status, createdAt])
}

model ServiceProcessTemplate {
  id          String    @id @default(uuid())
  tenantId    String
  code        String
  version     Int
  definition  Json
  draft       Json?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model ServiceProcessStep {
  id          String    @id @default(uuid())
  tenantId    String
  instanceId  String
  nodeId      String
  attempt     Int       @default(1)
  status      String    @default("ACTIVE")
  orderId     String?
  outcome     String?
  evidence    Json      @default("{}")
  actorId     String?
  enteredAt   DateTime  @default(now())
  dueAt       DateTime?
  completedAt DateTime?

  instance ServiceProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  order    ServiceOrder?          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([instanceId, nodeId, attempt])
  @@index([tenantId, instanceId, status])
}

model ServiceProcessOrderLink {
  id         String                 @id @default(uuid())
  instanceId String
  orderKey   String
  orderId    String
  instance   ServiceProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  order      ServiceOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([instanceId, orderKey])
}

model ServiceProcessEvent {
  id          String                 @id @default(uuid())
  instanceId  String
  tenantId    String
  eventKey    String                 @unique
  type        String
  payload     Json
  status      String                 @default("PENDING")
  attempts    Int                    @default(0)
  error       String?
  createdAt   DateTime               @default(now())
  processedAt DateTime?
  claimedAt   DateTime?
  instance    ServiceProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ServiceOrderStatusEvent {
  id             String   @id @default(uuid())
  tenantId       String
  serviceOrderId String
  fromStatus     String
  toStatus       String
  actorUserId    String?
  reason         String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, serviceOrderId])
  @@index([tenantId, createdAt])
}

model ServiceOrderAttachment {
  id             String   @id @default(uuid())
  serviceOrderId String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  isInternal     Boolean  @default(true)
  uploadedAt     DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId, uploadedAt(sort: Desc)])
}

model ServiceOrderApproval {
  id             String         @id @default(uuid())
  serviceOrderId String
  requestedById  String
  reviewedById   String?
  status         ApprovalStatus @default(PENDING)
  reason         String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("ApprovalReviewer", fields: [reviewedById], references: [id])

  @@index([serviceOrderId, status])
}

model SlaPolicy {
  id               String            @id @default(uuid())
  tenantId         String
  priority         Priority
  serviceOrderType ServiceOrderType?
  hours            Int
  isOverride       Boolean           @default(false)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, priority, active])
  @@index([tenantId, serviceOrderType, active])
}

model SlaEvent {
  id             String             @id @default(uuid())
  tenantId       String
  serviceOrderId String
  deadlineAt     DateTime
  breachedAt     DateTime?
  delayMinutes   Int                @default(0)
  snapshotStatus ServiceOrderStatus
  createdAt      DateTime           @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([serviceOrderId, createdAt(sort: Desc)])
}

model ProviderIntegration {
  id               String    @id @default(uuid())
  tenantId         String
  provider         String    @default("IXC")
  baseUrl          String
  webhookSecretEnc String?
  apiTokenEnc      String?
  status           String
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model SyncEvent {
  id            String       @id @default(uuid())
  tenantId      String
  integrationId String?
  source        SourceSystem
  eventType     String
  payload       Json?
  payloadHash   String?
  status        SyncStatus   @default(RECEIVED)
  errorMessage  String?
  receivedAt    DateTime     @default(now())
  processedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, source, receivedAt(sort: Desc)])
  @@index([status, receivedAt(sort: Desc)])
}

model AuditLog {
  id           String      @id @default(uuid())
  tenantId     String?
  actorUserId  String?
  action       AuditAction
  resourceType String
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

// Stores AuditLog records older than 90 days (no FK constraints — preserves history after user/tenant deletion)
model ArchivedAuditLog {
  id           String   @id
  tenantId     String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime
  archivedAt   DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([archivedAt(sort: Desc)])
}

model ReportExport {
  id          String   @id @default(uuid())
  tenantId    String?
  actorUserId String?
  reportType  String
  filters     Json?
  fileUrl     String?
  status      String
  createdAt   DateTime @default(now())

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
}

model KnowledgeArticle {
  id           String   @id @default(uuid())
  tenantId     String?
  authorUserId String?
  title        String
  slug         String
  content      String
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  author User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  tags   KnowledgeArticleTag[]

  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
}

model KnowledgeTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  articles KnowledgeArticleTag[]
}

model KnowledgeArticleTag {
  articleId String
  tagId     String

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     KnowledgeTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model KnowledgeCredential {
  id             String       @id @default(uuid())
  parentCredentialId String?
  accessMethod String @default("OUTROS")
  parentCredential KnowledgeCredential? @relation("CredentialAccesses", fields: [parentCredentialId], references: [id], onDelete: Restrict)
  accesses KnowledgeCredential[] @relation("CredentialAccesses")
  tenantId       String
  createdById    String?
  provider       String
  equipmentType  String       @default("OUTROS")
  equipmentName  String       @default("")
  environment    String
  host           String
  username       String
  secretEnc      String
  notes          String?
  sourceNoteEnc  String?
  protectedContentEnc String?
  totpSecretEnc String?
  sourceSystem   SourceSystem @default(ERP)
  externalId     String?
  sourceMetadata Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CredentialCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceSystem, externalId])
  @@index([tenantId, provider, createdAt(sort: Desc)])
  @@index([tenantId, provider, equipmentType, environment])
  @@index([parentCredentialId])
}

model ShiftReport {
  id String @id @default(uuid())
  tenantId String
  authorUserId String
  authorName String
  shift String
  referenceDate String
  startAt DateTime?
  endAt DateTime?
  content String
  orderIds Json @default("[]")
  publishedAt DateTime?
  version Int @default(1)
  revisions Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attachments ShiftReportAttachment[]
  @@index([tenantId, referenceDate, shift])
  @@index([tenantId, authorUserId])
}

model ShiftReportAttachment {
  id           String   @id @default(uuid())
  reportId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  uploadedAt   DateTime @default(now())

  report ShiftReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, uploadedAt(sort: Desc)])
}

model Note {
  id           String   @id @default(uuid())
  tenantId     String?
  authorUserId String?
  title        String
  content      String
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  author User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([tenantId, authorUserId, updatedAt])
}

model OccurrenceAnnotation {
  id                String   @id @default(uuid())
  tenantId          String
  occurrenceId      String
  actorUserId       String?
  message           String
  isCustomerVisible Boolean  @default(true)
  createdAt         DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  actorUser  User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurrenceId, createdAt(sort: Desc)])
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

enum CalendarEventType {
  REUNIAO
  REUNIAO_ONLINE
  PLANTAO
  FERIADO
  LEMBRETE
  OUTRO
}

model CalendarEvent {
  id          String            @id @default(uuid())
  tenantId    String
  title       String
  description String?
  type        CalendarEventType @default(OUTRO)
  isGlobal    Boolean           @default(false)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean           @default(false)
  meetingLink String?
  location    String?
  color       String?           @default("#3b82f6")
  createdById String?
  assigneeId  String?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?  @relation("CalendarEventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  recurrenceRule  String? // RRULE: FREQ=WEEKLY;BYDAY=MO,WE,FR
  recurrenceEnd   DateTime?
  parentEventId   String?
  serviceOrderId  String?
  occurrenceId    String?
  changeRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startAt])
  @@index([tenantId, assigneeId, startAt])
  @@index([tenantId, isGlobal, startAt])
}

// ─── CMDB (Configuration Management Database) ──────────────────────────────

enum AssetStatus {
  ATIVO
  INATIVO
  MANUTENCAO
  DESATIVADO
}

enum AssetCategory {
  SERVIDOR
  SWITCH
  ROTEADOR
  LINK_TRANSIT
  FIREWALL
  SOFTWARE
  CONTRATO
  OUTRO
}

model Asset {
  id           String        @id @default(uuid())
  tenantId     String
  name         String
  category     AssetCategory @default(OUTRO)
  status       AssetStatus   @default(ATIVO)
  description  String?
  location     String?
  serialNumber String?
  vendor       String?
  contractEnd  DateTime?
  tags         String[]      @default([])
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  serviceOrders   AssetServiceOrder[]
  configSnapshots AssetConfigSnapshot[]

  @@index([tenantId, status])
  @@index([tenantId, category])
}

model AssetConfigSnapshot {
  id          String   @id @default(uuid())
  tenantId    String
  assetId     String
  version     Int      @default(1)
  content     String
  notes       String?
  checksum    String
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([tenantId, assetId])
}

model AssetServiceOrder {
  id        String   @id @default(uuid())
  assetId   String
  orderId   String
  createdAt DateTime @default(now())

  asset Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([assetId, orderId])
}

// ─── Change Management (RFC / ITIL) ────────────────────────────────────────

enum ChangeStatus {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
  REJEITADO
}

enum ChangeRisk {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

model ChangeRequest {
  version Int @default(0)
  serviceOrders   ServiceOrder[]
  id              String       @id @default(uuid())
  tenantId        String
  number          String
  title           String
  description     String
  justification   String
  rollbackPlan    String?
  status          ChangeStatus @default(RASCUNHO)
  risk            ChangeRisk   @default(MEDIO)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  executedById    String?
  affectedSystems String[]     @default([])
  tags            String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("ChangeRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?  @relation("ChangeRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  executedBy  User?  @relation("ChangeRequestExecutor", fields: [executedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, plannedStart])
}

// ─── Time Tracking ─────────────────────────────────────────────────────────

model TimeEntry {
  id          String   @id @default(uuid())
  tenantId    String
  orderId     String
  userId      String
  minutes     Int
  description String?
  billable    Boolean  @default(true)
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, userId, loggedAt])
}

// ─── Notification Config ────────────────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  WEBHOOK
  SLACK
  WHATSAPP
}

enum NotificationTrigger {
  ORDER_CREATED
  ORDER_ESCALATED
  ORDER_CLOSED
  SLA_BREACH_WARNING
  OCCURRENCE_CREATED
}

model NotificationConfig {
  id        String              @id @default(uuid())
  tenantId  String
  name      String
  channel   NotificationChannel
  trigger   NotificationTrigger
  target    String // email address, webhook URL, slack webhook
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([tenantId, trigger])
}

// ─── On-Call Schedule ──────────────────────────────────────────────────────

model TeamRosterPolicy {
  id            String   @id @default(uuid())
  tenantId      String
  effectiveFrom String
  dayUserIds    String[] @default([])
  nightUserIds  String[] @default([])
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, effectiveFrom])
}

model TeamRosterDay {
  id          String   @id @default(uuid())
  tenantId    String
  date        String
  userIds     String[] @default([])
  holidayName String?
  notes       String?
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

model OnCallSchedule {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
}

// ─── API Keys ──────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, active])
  @@index([keyPrefix])
}

// ─── CSAT (Satisfaction Survey) ────────────────────────────────────────────

model SatisfactionResponse {
  id         String    @id @default(uuid())
  tenantId   String
  orderId    String    @unique
  score      Int // 1-5
  comment    String?
  token      String    @unique @default(uuid())
  answered   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId, answered])
}

// ─── OS Process Templates ────────────────────────────────────────────────────

model OsProcessTemplate {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  enabled        Boolean  @default(true)
  /// JSON: String[] — ServiceOrderType values that trigger this template on close
  triggerOsTypes Json
  /// JSON: { childOrders: ChildOrderSpec[] }
  definition     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

// ─── Workflow Automation Engine ───────────────────────────────────────────────

model WorkflowRule {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  enabled     Boolean   @default(true)
  /// JSON: { trigger, conditions[], actions[], nodes[], edges[] }
  definition  Json
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowExecutionLogs WorkflowExecutionLog[]

  @@index([tenantId, enabled])
}

model WorkflowExecutionLog {
  id          String   @id @default(uuid())
  tenantId    String
  ruleId      String
  ruleName    String
  nodeId      String
  nodeType    String
  nodeSubtype String
  context     Json
  result      Json?
  status      String
  error       String?
  createdAt   DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, ruleId])
  @@index([tenantId, createdAt])
}

// ─── SLA: Business Calendar ──────────────────────────────────────────────────

model BusinessCalendar {
  id        String  @id @default(uuid())
  tenantId  String
  dayOfWeek Int // 0=Sunday, 6=Saturday
  startTime String  @default("08:00")
  endTime   String  @default("18:00")
  isWorkDay Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
}

model BusinessCalendarException {
  id        String   @id @default(uuid())
  tenantId  String
  date      DateTime
  isWorkDay Boolean  @default(false)
  startTime String?
  endTime   String?
  reason    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

model SlaAuditEvent {
  id         String    @id @default(uuid())
  tenantId   String
  orderId    String
  eventType  String // CREATED, RECALCULATED, PAUSED, RESUMED, BREACHED, RESOLVED
  deadlineAt DateTime?
  reason     String?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
}

// ==== CMDB EXTENSION EXPERIMENT ==== //
model ProviderProfile {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  asNumber      String? // Autonomous System Number
  oltVendors    String[] // Huawei, ZTE, Nokia
  routerVendors String[] // Mikrotik, Cisco, Juniper
  upstreamLinks String[] // Telecom A, Telecom B
  cgnatType     String? // A10, Mikrotik nat, etc
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Service Catalog (Catálogo de Serviços Especializados para ISPs) ─────────

model ServiceCatalogItem {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  workflowTemplateCode String?
  category         ServiceOrderType @default(AUDITORIA)
  description      String?
  estimatedMinutes Int?             @default(120)
  defaultPriority  Priority         @default(NORMAL)
  checklist        Json             @default("[]")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([tenantId, category])
}

/// Import provenance for entities without native source keys; no secrets or raw notes belong here.
model ExternalImportLink {
  id          String   @id @default(uuid())
  tenantId    String
  kind        String
  externalKey String
  localId     String
  metadata    Json     @default("{}")
  importedAt  DateTime @default(now())

  @@unique([tenantId, kind, externalKey])
  @@index([tenantId, kind, localId])
}

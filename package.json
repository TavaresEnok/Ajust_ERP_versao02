{
  "name": "ajust-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.1.19",
      "@nestjs/core": "11.1.19",
      "@nestjs/platform-express": "11.1.19",
      "@nestjs/platform-socket.io": "11.1.19",
      "@nestjs/websockets": "11.1.19",
      "@nestjs/testing": "11.1.19",
      "follow-redirects": "^1.16.2",
      "socket.io-parser": "^4.2.7",
      "postcss": "^8.5.23",
      "yaml": "^2.8.3",
      "picomatch": "^4.0.4",
      "defu": "^6.1.7",
      "effect": "^3.20.0",
      "qs": "^6.16.1",
      "ws": "^8.20.1",
      "express>path-to-regexp": "0.1.13",
      "deepmerge-ts": "^8.0.2",
      "proxy-addr": "^2.0.8",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "glob@10": "^14.0.4",
      "minimatch@9": "^11.0.5",
      "minimatch@10": "^11.0.5",
      "multer": "^2.5.0",
      "glob@13": "^14.0.4"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "lint:fix": "corepack pnpm exec eslint apps/api apps/worker packages/shared scripts --fix && corepack pnpm --filter @ajust/web exec eslint . --fix",
    "typecheck": "corepack pnpm -r typecheck",
    "test:e2e": "corepack pnpm --filter @ajust/api test:e2e",
    "test:e2e:security": "corepack pnpm --filter @ajust/api test:e2e:security",
    "test:unit": "corepack pnpm --filter @ajust/api test && corepack pnpm --filter @ajust/worker test",
    "test:unit:coverage": "corepack pnpm --filter @ajust/api test:coverage && corepack pnpm --filter @ajust/worker test:coverage",
    "audit": "node scripts/audit-dependencies.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,cjs,json}\" \"packages/**/*.ts\" \"scripts/**/*.{js,cjs}\" \"*.{json,mjs}\" \"eslint.config.mjs\" \"apps/web/eslint.config.mjs\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,cjs,json}\" \"packages/**/*.ts\" \"scripts/**/*.{js,cjs}\" \"*.{json,mjs}\" \"eslint.config.mjs\" \"apps/web/eslint.config.mjs\"",
    "validate": "corepack pnpm lint && corepack pnpm format:check && corepack pnpm typecheck && corepack pnpm run audit && corepack pnpm test:scripts && corepack pnpm test:unit:coverage && node scripts/check-root-files.mjs",
    "test:web": "bash scripts/web-smoke.sh",
    "test:web:e2e": "corepack pnpm --filter @ajust/web exec playwright test",
    "test:analyst:journey": "bash scripts/test-analyst-journey.sh",
    "test:manager:journey": "bash scripts/test-manager-journey.sh",
    "test:web:e2e:ui": "corepack pnpm --filter @ajust/web exec playwright test --ui",
    "test:load": "node scripts/load-smoke.mjs",
    "monitoring:check": "node scripts/monitoring-smoke.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "db:generate": "corepack pnpm exec prisma generate --schema prisma/schema.prisma",
    "db:migrate": "corepack pnpm exec prisma migrate dev --schema prisma/schema.prisma",
    "db:import:hub:pilot": "corepack pnpm exec node scripts/import-hub-real-pilot.cjs",
    "db:import:sgp:pilot": "node --env-file=.env apps/api/node_modules/tsx/dist/cli.mjs scripts/import-sgp-meganet-pilot.ts",
    "db:import:sgp:registry": "node --env-file=.env apps/api/node_modules/tsx/dist/cli.mjs scripts/import-sgp-registry.ts",
    "db:seed:roles": "corepack pnpm --filter @ajust/shared db:seed:roles",
    "db:seed:dev-admin": "corepack pnpm --filter @ajust/shared db:seed:dev-admin",
    "db:seed:demo-users": "corepack pnpm --filter @ajust/shared db:seed:demo-users",
    "db:seed:knowledge": "node scripts/replace-ajustpedia-knowledge.cjs",
    "test:scripts": "node --test scripts/*.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
